# Copiar como .env y completar. La contraseña debe coincidir con MSSQL_SA_PASSWORD de docker-compose.yml.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=bulon_stock;encrypt=true;trustServerCertificate=true
DB_USER=sa
DB_PASSWORD=

# Carga datos de ejemplo (usuarios, proveedores y productos) si la base está vacía
SEED_ENABLED=true
